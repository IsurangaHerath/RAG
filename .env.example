# Technical Document Intelligence RAG — example configuration
#
# SETUP
#   1. Copy this file to `.env`   (PowerShell:  Copy-Item .env.example .env)
#   2. Replace the placeholder values below with your own.
#   3. `.env` is git-ignored. NEVER commit it or paste a real key here.
#
# Any line starting with # is a comment. Values shown are the defaults, so
# you may delete a line entirely if the default is what you want.

# --- LLM / provider ---------------------------------------------------------

# REQUIRED before any live OpenAI call. Leave blank to run offline tests.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# Chat model used to write grounded answers.
CHAT_MODEL=gpt-4o-mini

# Embedding model used to index and query documents.
# IMPORTANT: changing this invalidates your existing ChromaDB index.
EMBEDDING_MODEL=text-embedding-3-large

# How long to wait for OpenAI before giving up (seconds).
REQUEST_TIMEOUT_SECONDS=60

# Maximum tokens the LLM may generate in one answer.
MAX_OUTPUT_TOKENS=1024

# --- Data directories -------------------------------------------------------
# Defaults are relative to the repository root and are created on startup.
# DATA_DIR=./data
# CHROMA_PERSIST_DIR=./data/chroma
# SAMPLE_DOCS_DIR=./data/samples

# --- Chunking ---------------------------------------------------------------
# Larger chunks give the model more context but weaker topical focus;
# overlap prevents facts split across a boundary from being lost.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval --------------------------------------------------------------
# How many chunks to fetch per question.
TOP_K=5

# Optional relevance cutoff in 0..1. Leave empty until calibrated on real
# evaluation data, otherwise it may discard correct answers.
# RETRIEVAL_THRESHOLD=

# --- HTTP limits ------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_QUERY_CHARS=4000
API_HOST=127.0.0.1
API_PORT=8000

# --- Logging ----------------------------------------------------------------
# One of: CRITICAL, ERROR, WARNING, INFO, DEBUG, NOTSET
LOG_LEVEL=INFO

# Keep this False in normal use. True writes document text to logs, which
# can leak confidential content into log files.
LOG_DOCUMENT_CONTENT=False
